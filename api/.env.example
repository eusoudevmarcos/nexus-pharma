PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/nexus_pharma?schema=public
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL=15m
JWT_ISSUER=nexus-pharma-api
JWT_AUDIENCE=nexus-pharma-web
REFRESH_TOKEN_TTL_DAYS=30
MAX_ACTIVE_SESSIONS=5
PRIVACY_REQUEST_SLA_DAYS=15
AUTH_SESSION_RETENTION_DAYS=90
ONE_TIME_TOKEN_RETENTION_DAYS=30

# Deve refletir a capacidade realmente contratada no provedor. O modo NONE
# impede o painel de marcar a operação como pronta sem restauração disponível.
DATABASE_RECOVERY_MODE=NONE
DATABASE_RECOVERY_WINDOW_DAYS=0
TRUST_PROXY=false
LOG_LEVEL=info
SERVICE_VERSION=development
DEPLOYMENT_STAGE=development
WEB_APP_URL=http://localhost:3100

# Relay transacional compatível com POST JSON. Sem estas chaves, o sistema
# mantém o convite em modo manual e exibe o link seguro ao administrador.
EMAIL_RELAY_URL=
EMAIL_RELAY_KEY=
EMAIL_FROM=Nexus Pharma <convites@nexuspharma.com.br>

# Segredo HMAC compartilhado com o adaptador do provedor de cobrança.
BILLING_WEBHOOK_SECRET=
BILLING_RELAY_URL=
BILLING_RELAY_KEY=
OBSERVABILITY_TOKEN=

# O seed cria o administrador interno somente quando ambos forem definidos.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
