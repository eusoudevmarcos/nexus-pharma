model DfeDocument {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  environment      DfeEnvironment
  nsu              String?            @db.Char(15)
  accessKey        String?            @map("access_key") @db.Char(44)
  schemaName       String             @map("schema_name") @db.VarChar(120)
  documentType     DfeDocumentType    @map("document_type")
  status           DfeDocumentStatus  @default(DISCOVERED)
  rawXml           String             @map("raw_xml") @db.Text
  xmlHash          String             @map("xml_hash") @db.Char(64)
  issuerTaxId      String?            @map("issuer_tax_id") @db.VarChar(14)
  issuerName       String?            @map("issuer_name") @db.VarChar(180)
  recipientTaxId   String?            @map("recipient_tax_id") @db.VarChar(14)
  originState      String?            @map("origin_state") @db.Char(2)
  destinationState String?            @map("destination_state") @db.Char(2)
  documentNumber   String?            @map("document_number") @db.VarChar(60)
  issuedAt         DateTime?          @map("issued_at") @db.Timestamptz(3)
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(15, 2)
  summary          Json               @default("{}")
  receivedAt       DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  company          Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items            DfeDocumentItem[]
  discrepancies    DfeDiscrepancy[]
  manifestations   DfeManifestation[]
  receiving        DfeReceiving?
  accountPayable   AccountPayable?
  supplierReturns  SupplierReturn[]

  @@unique([companyId, environment, nsu])
  @@unique([companyId, environment, accessKey, documentType])
  @@index([companyId, status, issuedAt])
  @@index([xmlHash])
  @@map("dfe_documents")
}

model DfeDocumentItem {
