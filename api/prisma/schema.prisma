model User {
  id                       String                  @id @default(uuid()) @db.Uuid
  email                    String                  @unique @db.VarChar(254)
  passwordHash             String?                 @map("password_hash") @db.VarChar(255)
  name                     String                  @db.VarChar(160)
  systemRole               SystemRole              @default(CUSTOMER) @map("system_role")
  status                   AccountStatus           @default(INVITED)
  lastLoginAt              DateTime?               @map("last_login_at") @db.Timestamptz(3)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships              Membership[]
  authSessions             AuthSession[]
  oneTimeTokens            OneTimeToken[]
  invitationsSent          Invitation[]            @relation("InvitationCreator")
  ticketsCreated           SupportTicket[]         @relation("TicketCreator")
  ticketsAssigned          SupportTicket[]         @relation("TicketAssignee")
  ticketMessages           TicketMessage[]
  releasesCreated          Release[]               @relation("ReleaseCreator")
  releaseApprovals         ReleaseApproval[]
  releasesEnabled          CustomerRelease[]       @relation("ReleaseEnabler")
  apiCredentials           ApiCredential[]
  analysesRequested        TaxAnalysis[]           @relation("AnalysisRequester")
  analysesReviewed         TaxAnalysis[]           @relation("AnalysisReviewer")
  auditLogs                AuditLog[]
  incidentsResolved        OperationalIncident[]   @relation("IncidentResolver")
  alertsAcknowledged       BusinessAlert[]         @relation("AlertAcknowledgedBy")
  savingsVerified          MonthlySavingsLedger[]  @relation("SavingsVerifier")
  privacyRequests          PrivacyRequest[]        @relation("PrivacyRequestSubject")
  privacyRequestsMade      PrivacyRequest[]        @relation("PrivacyRequestCreator")
  privacyRequestsHandled   PrivacyRequest[]        @relation("PrivacyRequestHandler")
  recoveryDrills           RecoveryDrill[]         @relation("RecoveryDrillPerformer")
  taxProvenancesApproved   TaxProvenance[]         @relation("TaxProvenanceApprover")
  taxAssessmentsRequested  TaxExitAssessment[]     @relation("TaxAssessmentRequester")
  dfeCertificatesInstalled DfeCertificate[]        @relation("DfeCertificateInstaller")
  dfeReceivingsStarted     DfeReceiving[]          @relation("DfeReceivingStarter")
  dfeReceivingsCompleted   DfeReceiving[]          @relation("DfeReceivingCompleter")
  dfeManifestationsCreated DfeManifestation[]      @relation("DfeManifestationCreator")
  nfceDocumentsCreated     NfceDocument[]          @relation("NfceDocumentCreator")
  cashSessionsOpened       CashSession[]           @relation("CashSessionOpener")
  cashSessionsClosed       CashSession[]           @relation("CashSessionCloser")
  cashMovementsCreated     CashMovement[]          @relation("CashMovementCreator")
  salePaymentsCreated      SalePayment[]           @relation("SalePaymentCreator")
  reconciliationsReviewed  CashReconciliation[]    @relation("CashReconciliationReviewer")
  saleReversalsCreated     SaleReversal[]          @relation("SaleReversalCreator")
  salesAsSeller            Sale[]                  @relation("SaleSeller")
  pharmacistCredentials    PharmacistCredential[]
  controlledSalesCreated   ControlledSaleRecord[]  @relation("ControlledSaleCreator")
  stockReservationsCreated StockReservation[]      @relation("StockReservationCreator")
  stockTransfersCreated    StockTransfer[]         @relation("StockTransferCreator")
  stockTransfersDispatched StockTransfer[]         @relation("StockTransferDispatcher")
  stockTransfersReceived   StockTransfer[]         @relation("StockTransferReceiver")
  inventoryCountsCreated   InventoryCount[]        @relation("InventoryCountCreator")
  inventoryCountsSubmitted InventoryCount[]        @relation("InventoryCountSubmitter")
  inventoryCountsApproved  InventoryCount[]        @relation("InventoryCountApprover")
  stockAdjustmentsCreated  StockAdjustment[]       @relation("StockAdjustmentCreator")
  stockAdjustmentsApproved StockAdjustment[]       @relation("StockAdjustmentApprover")
  managerialPeriodsClosed  ManagerialPeriodClose[] @relation("ManagerialPeriodCloser")
  purchaseOrdersCreated    PurchaseOrder[]         @relation("PurchaseOrderCreator")
  purchaseOrdersApproved   PurchaseOrder[]         @relation("PurchaseOrderApprover")
  purchaseReceiptsLinked   PurchaseOrderReceipt[]  @relation("PurchaseReceiptLinker")
  accountsPayableCreated   AccountPayable[]        @relation("AccountPayableCreator")
  accountsPayableApproved  AccountPayable[]        @relation("AccountPayableApprover")
  payablePaymentsRecorded  PayablePayment[]        @relation("PayablePaymentRecorder")
  payablePaymentsReversed  PayablePayment[]        @relation("PayablePaymentReverser")
  purchaseQuotesCreated    PurchaseQuote[]         @relation("PurchaseQuoteCreator")
  purchaseQuotesAwarded    PurchaseQuote[]         @relation("PurchaseQuoteAwarder")
  supplierReturnsCreated   SupplierReturn[]        @relation("SupplierReturnCreator")
  posDevicesRegistered     PosDevice[]             @relation("PosDeviceRegistrar")
  offlineSnapshotsCreated  OfflinePosSnapshot[]    @relation("OfflineSnapshotCreator")
  offlineCommandsSubmitted OfflinePosCommand[]     @relation("OfflineCommandSubmitter")
  fiscalCatalogImports     FiscalCatalogRelease[]  @relation("FiscalCatalogReleaseImporter")
  fiscalCatalogReviews     FiscalCatalogRelease[]  @relation("FiscalCatalogReleaseReviewer")
  nfceConfigurations       NfceConfiguration[]     @relation("NfceConfigurationEditor")

  @@map("users")
}

model AuthSession {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash") @db.VarChar(255)
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(255)
  userAgent                String?   @map("user_agent") @db.VarChar(500)
  ipAddress                String?   @map("ip_address") @db.VarChar(64)
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt               DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason") @db.VarChar(80)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([previousRefreshTokenHash])
  @@index([revokedAt, expiresAt])
  @@map("auth_sessions")
}

model OneTimeToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("one_time_tokens")
}

model Company {
  id                     String                  @id @default(uuid()) @db.Uuid
  cnpj                   String?                 @unique @db.Char(14)
  legalName              String                  @map("legal_name") @db.VarChar(180)
  tradeName              String                  @map("trade_name") @db.VarChar(180)
  branchName             String                  @default("Matriz") @map("branch_name") @db.VarChar(120)
  taxRegime              TaxRegime               @default(SIMPLES_NACIONAL) @map("tax_regime")
  state                  String?                 @db.Char(2)
  city                   String?                 @db.VarChar(120)
  status                 CompanyStatus           @default(ONBOARDING)
  onboardingStep         Int                     @default(1) @map("onboarding_step")
  settings               Json                    @default("{}")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships            Membership[]
  invitations            Invitation[]
  subscriptions          Subscription[]
  fiscalCategories       FiscalCategory[]
  products               Product[]
  stockMovements         StockMovement[]
  sales                  Sale[]
  monthlyProvisions      MonthlyProvision[]
  reorderAlerts          ReorderAlert[]
  taxAnalyses            TaxAnalysis[]
  supportTickets         SupportTicket[]
  customerReleases       CustomerRelease[]
  apiCredentials         ApiCredential[]
  auditLogs              AuditLog[]
  emailDeliveries        EmailDelivery[]
  billingEvents          BillingWebhookEvent[]
  businessAlerts         BusinessAlert[]
  stores                 Store[]
  onboardings            CustomerOnboarding[]
  savingsLedgers         MonthlySavingsLedger[]
  privacyRequests        PrivacyRequest[]
  taxProvenances         TaxProvenance[]
  taxExitAssessments     TaxExitAssessment[]
  fiscalMatrixRules      FiscalMatrixRule[]
  dfeCertificates        DfeCertificate[]
  dfeCursors             DfeDistributionCursor[]
  dfeDocuments           DfeDocument[]
  dfeReceivings          DfeReceiving[]
  nfceDocuments          NfceDocument[]
  nfceNumberSequences    NfceNumberSequence[]
  cashSessions           CashSession[]
  salePayments           SalePayment[]
  saleReversals          SaleReversal[]
  customers              Customer[]
  pharmacistCredentials  PharmacistCredential[]
  controlledSaleRecords  ControlledSaleRecord[]
  storeStockBalances     StoreStockBalance[]
  stockReservations      StockReservation[]
  stockTransfers         StockTransfer[]
  inventoryCounts        InventoryCount[]
  stockAdjustments       StockAdjustment[]
  managerialPeriodCloses ManagerialPeriodClose[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  accountsPayable        AccountPayable[]
  purchaseQuotes         PurchaseQuote[]
  supplierReturns        SupplierReturn[]
  posDevices             PosDevice[]
  offlinePosSnapshots    OfflinePosSnapshot[]
  offlinePosCommands     OfflinePosCommand[]
  nfceConfigurations     NfceConfiguration[]

  @@index([status])
  @@map("companies")
}

model Membership {
  id        String     @id @default(uuid()) @db.Uuid
  companyId String     @map("company_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole @default(OPERATOR)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId, active])
  @@map("memberships")
}

model Invitation {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  email       String          @db.VarChar(254)
  role        TenantRole
  tokenHash   String          @unique @map("token_hash") @db.VarChar(255)
  invitedById String          @map("invited_by_id") @db.Uuid
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?       @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User            @relation("InvitationCreator", fields: [invitedById], references: [id])
  deliveries  EmailDelivery[]

  @@index([companyId, email])
  @@map("invitations")
}

model Plan {
  id                   String         @id @default(uuid()) @db.Uuid
  code                 String         @unique @db.VarChar(50)
  name                 String         @db.VarChar(100)
  description          String         @default("") @db.VarChar(500)
  monthlyPrice         Decimal        @map("monthly_price") @db.Decimal(12, 2)
  yearlyPrice          Decimal        @map("yearly_price") @db.Decimal(12, 2)
  setupPrice           Decimal        @default(890) @map("setup_price") @db.Decimal(12, 2)
  successFeeRate       Decimal        @default(0) @map("success_fee_rate") @db.Decimal(9, 6)
  hasFineTuning        Boolean        @default(false) @map("has_fine_tuning")
  includedStores       Int            @default(1) @map("included_stores")
  includedPdvsPerStore Int            @default(1) @map("included_pdvs_per_store")
  additionalStorePrice Decimal        @default(1000) @map("additional_store_price") @db.Decimal(12, 2)
  extraPdvPrice        Decimal        @default(280) @map("extra_pdv_price") @db.Decimal(12, 2)
  limits               Json           @default("{}")
  features             Json           @default("[]")
  active               Boolean        @default(true)
  position             Int            @default(0)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions        Subscription[]

  @@index([active, position])
  @@map("plans")
}

model Subscription {
  id                 String                @id @default(uuid()) @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  planId             String                @map("plan_id") @db.Uuid
  status             SubscriptionStatus    @default(TRIALING)
  interval           BillingInterval       @default(MONTHLY)
  provider           String?               @db.VarChar(40)
  providerCustomerId String?               @map("provider_customer_id") @db.VarChar(120)
  providerContractId String?               @unique @map("provider_contract_id") @db.VarChar(120)
  trialEndsAt        DateTime?             @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime?             @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime?             @map("current_period_end") @db.Timestamptz(3)
  contractStartedAt  DateTime              @default(now()) @map("contract_started_at") @db.Timestamptz(3)
  cancelledAt        DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan               Plan                  @relation(fields: [planId], references: [id])
  invoices           Invoice[]
  billingEvents      BillingWebhookEvent[]
  onboarding         CustomerOnboarding?

  @@index([companyId, status])
  @@map("subscriptions")
}

model Invoice {
  id                String                 @id @default(uuid()) @db.Uuid
  subscriptionId    String                 @map("subscription_id") @db.Uuid
  status            InvoiceStatus          @default(DRAFT)
  amount            Decimal                @db.Decimal(12, 2)
  dueAt             DateTime               @map("due_at") @db.Timestamptz(3)
  billingPeriod     DateTime?              @map("billing_period") @db.Date
  requiresReview    Boolean                @default(false) @map("requires_review")
  calculationHash   String?                @map("calculation_hash") @db.Char(64)
  paidAt            DateTime?              @map("paid_at") @db.Timestamptz(3)
